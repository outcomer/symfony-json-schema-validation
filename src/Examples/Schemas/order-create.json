{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "description": "Create an order - demonstrates multi-level nesting, relative $ref reuse (customer/name/email/order-item) and an absolute $ref into a separately registered schema domain (common/address, common/country)",
    "properties": {
        "body": {
            "type": "object",
            "properties": {
                "customer": {
                    "$ref": "customer.json"
                },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "order-item.json"
                    }
                }
            },
            "required": [
                "customer",
                "items"
            ],
            "additionalProperties": false
        }
    }
}